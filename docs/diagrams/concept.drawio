        <mxCell id="lg1001" value="The big picture: what happens to one instruction" style="text;html=1;whiteSpace=wrap;fontStyle=1;align=left;valign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="30" as="geometry"/></mxCell><mxCell id="lg1002" value="Fetch&lt;br&gt;read the next instruction&lt;br&gt;from memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;align=center;valign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="90" as="geometry"/></mxCell><mxCell id="lg1003" value="Decode&lt;br&gt;figure out what it means,&lt;br&gt;read any registers it needs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;align=center;valign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="220" height="90" as="geometry"/></mxCell><mxCell id="lg1004" value="Execute&lt;br&gt;do the math (add, compare,&lt;br&gt;compute an address, ...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;align=center;valign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="100" width="220" height="90" as="geometry"/></mxCell><mxCell id="lg1005" value="Write back&lt;br&gt;save the result&lt;br&gt;(register or memory)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;align=center;valign=middle;" vertex="1" parent="1"><mxGeometry x="880" y="100" width="220" height="90" as="geometry"/></mxCell><mxCell id="lg1006" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lg1002" target="lg1003"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lg1007" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lg1003" target="lg1004"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lg1008" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lg1004" target="lg1005"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lg1009" value="This core does all four steps for one instruction in a single clock cycle (&quot;single-cycle&quot;), then starts the next instruction's fetch on the next clock edge -- no instruction is ever partway through the pipe while another one starts. The detailed diagram below shows the real modules and wires that make this happen." style="text;html=1;whiteSpace=wrap;align=left;valign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="1060" height="70" as="geometry"/></mxCell><mxCell id="lg1010" value="Legend" style="text;html=1;whiteSpace=wrap;fontStyle=1;align=left;valign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="300" height="20" as="geometry"/></mxCell><mxCell id="lg1011" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=1;" vertex="1" parent="1"><mxGeometry x="40" y="356" width="22" height="16" as="geometry"/></mxCell><mxCell id="lg1012" value="Fetch and execute -- the core's main datapath" style="text;html=1;whiteSpace=wrap;align=left;valign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="72" y="353" width="800" height="22" as="geometry"/></mxCell><mxCell id="lg1013" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=1;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="22" height="16" as="geometry"/></mxCell><mxCell id="lg1014" value="Decode -- figuring out what the instruction means" style="text;html=1;whiteSpace=wrap;align=left;valign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="72" y="377" width="800" height="22" as="geometry"/></mxCell><mxCell id="lg1015" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=1;" vertex="1" parent="1"><mxGeometry x="40" y="404" width="22" height="16" as="geometry"/></mxCell><mxCell id="lg1016" value="Write back -- where the result ends up" style="text;html=1;whiteSpace=wrap;align=left;valign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="72" y="401" width="800" height="22" as="geometry"/></mxCell>
