        <mxCell id="title1" value="RV32I datapath with MACC extension (MAC unit highlighted)" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="10" y="-40" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend1" value="Yellow = pipeline stage grouping. Blue = datapath/control functional blocks. Green = storage (instruction memory, register file, data memory). Purple = the control unit. Red = the MAC unit added for this extension (result = acc + a*b), plus the widened Result Mux/Register File paths its new accumulator port needed -- the thick edges are those new/changed paths. Dashed edges are next-PC control paths; solid edges are data." style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="10" y="1320" width="900" height="70" as="geometry" />
        </mxCell>
